<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Marketing - Authentic Online Review Provider & Google Map SEO Specialist</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* General Styles & Variables */
        :root {
            --bg-color: #050511;
            --surface-color: #0b0f19;
            --card-bg: #121826;
            --primary-color: #4a90e2;
            --text-main: #f0f4f8;
            --text-muted: #a0aec0;
            --border-color: #2d3748;
            --accent-glow: rgba(74, 144, 226, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: var(--text-main);
            transition: color 0.3s ease;
        }

        a:hover {
            color: var(--primary-color);
        }

        /* Navbar */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: rgba(5, 5, 17, 0.9);
            backdrop-filter: blur(10px);
            z-index: 1000;
            border-bottom: 1px solid var(--border-color);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo img {
            width: 40px;
            height: 40px;
            border-radius: 5px;
            object-fit: cover;
        }

        .logo span {
            font-weight: 700;
            font-size: 1.2rem;
            letter-spacing: 1px;
        }

        .menu-btn {
            background: none;
            border: none;
            color: var(--text-main);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 2px;
        }

        /* Mobile Menu Overlay */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--bg-color);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            transform: translateY(-100%);
            transition: transform 0.4s ease-in-out;
        }

        .mobile-menu.active {
            transform: translateY(0);
        }

        .close-menu {
            position: absolute;
            top: 25px;
            right: 5%;
            background: none;
            border: none;
            color: var(--text-main);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 1px;
        }

        .mobile-menu ul {
            list-style: none;
            text-align: center;
        }

        .mobile-menu ul li {
            margin: 20px 0;
        }

        .mobile-menu ul li a {
            font-size: 2rem;
            font-weight: 500;
        }

        .mobile-contact {
            margin-top: 40px;
            text-align: center;
        }
        
        .mobile-contact p {
            color: var(--text-muted);
            margin-bottom: 10px;
        }

        /* Hero Section */
        .hero {
            padding: 150px 5% 100px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            background: radial-gradient(circle at top right, rgba(200, 80, 0, 0.15), transparent 40%),
                        radial-gradient(circle at bottom left, var(--accent-glow), transparent 40%);
        }

        .hero h1 {
            font-size: clamp(2rem, 5vw, 4rem);
            font-weight: 400;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: var(--primary-color);
            font-weight: 600;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
            margin-bottom: 40px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background-color: #1c64f2;
            color: white;
            padding: 15px 30px;
            border-radius: 8px;
            font-weight: 500;
            font-size: 1rem;
            transition: background-color 0.3s ease;
        }

        .btn:hover {
            background-color: #1a56cc;
            color: white;
        }
        
        .btn-outline {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-main);
        }
        
        .btn-outline:hover {
            background-color: var(--card-bg);
            border-color: var(--text-muted);
        }

        /* Sections General */
        section {
            padding: 80px 5%;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-header h2 {
            font-size: 2.5rem;
            font-weight: 500;
            margin-bottom: 15px;
        }

        .section-header p {
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Services Section */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .service-card {
            background-color: var(--card-bg);
            padding: 30px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            border-color: var(--primary-color);
        }

        .service-icon {
            font-size: 2rem;
            margin-bottom: 20px;
        }

        .service-card h3 {
            font-size: 1.3rem;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .service-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 20px;
        }
        
        .service-card ul {
            list-style: none;
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        
        .service-card ul li {
            margin-bottom: 8px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }
        
        .service-card ul li i {
            color: var(--primary-color);
            margin-top: 4px;
            font-size: 0.8rem;
        }

        /* Work Process */
        .process-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            text-align: center;
        }
        
        .process-step {
            position: relative;
        }
        
        .step-number {
            width: 50px;
            height: 50px;
            border: 2px solid var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0 auto 20px;
            color: var(--primary-color);
        }
        
        .step-icon {
            font-size: 2rem;
            margin-bottom: 15px;
        }
        
        .process-step h3 {
            margin-bottom: 10px;
            font-size: 1.2rem;
        }
        
        .process-step p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Reviews / Proofs Section */
        .reviews-header {
            text-align: center;
            margin-bottom: 40px;
        }
        
        .badge {
            display: inline-block;
            padding: 5px 15px;
            background-color: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 20px;
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .gallery-item {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            aspect-ratio: 1 / 1;
            cursor: pointer;
            border: 1px solid var(--border-color);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.05);
        }

        /* About Section */
        .about-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }

        .about-image {
            width: 250px;
            height: 250px;
            border-radius: 15px;
            overflow: hidden;
            margin-bottom: 30px;
            border: 2px solid var(--border-color);
        }

        .about-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .about-text h3 {
            font-size: 2rem;
            margin-bottom: 10px;
        }
        
        .about-text h4 {
            color: var(--text-muted);
            font-weight: 400;
            margin-bottom: 20px;
        }

        .about-text p {
            color: var(--text-muted);
            margin-bottom: 15px;
            font-size: 1rem;
        }
        
        /* Stats Section */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            margin-top: 50px;
            text-align: center;
        }
        
        .stat-item {
            background-color: var(--card-bg);
            padding: 30px 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 10px;
        }
        
        .stat-text {
            color: var(--text-muted);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Contact Section */
        .contact-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .contact-card {
            background-color: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .contact-card .icon {
            width: 50px;
            height: 50px;
            background-color: rgba(255,255,255,0.05);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--primary-color);
        }
        
        .contact-info p:first-child {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 5px;
        }
        
        .contact-info p:last-child {
            font-weight: 500;
            font-size: 1.1rem;
        }

        .cta-buttons {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 30px;
        }
        
        .btn-whatsapp {
            background-color: #25D366;
        }
        
        .btn-whatsapp:hover {
            background-color: #1ebe57;
        }
        
        .btn-telegram {
            background-color: #0088cc;
        }
        
        .btn-telegram:hover {
            background-color: #0077b5;
        }

        /* Footer */
        footer {
            background-color: var(--surface-color);
            padding: 60px 5% 30px;
            border-top: 1px solid var(--border-color);
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            margin-bottom: 50px;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .footer-logo img {
            width: 40px;
            height: 40px;
            border-radius: 5px;
        }

        .footer-col h4 {
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: var(--text-main);
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col ul li {
            margin-bottom: 12px;
        }

        .footer-col ul li a {
            color: var(--text-muted);
        }
        
        .footer-col ul li a:hover {
            color: var(--primary-color);
        }

        .footer-bottom {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.9rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 20px;
        }
        
        .footer-bottom-links {
            display: flex;
            gap: 20px;
        }

        /* Image Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 3000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            max-width: 90%;
            max-height: 90vh;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.5);
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            color: white;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .hero {
                padding-top: 120px;
                text-align: center;
                align-items: center;
            }
            
            .footer-bottom {
                flex-direction: column;
                justify-content: center;
            }
            
            .footer-bottom-links {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav>
        <div class="logo">
            <img src="https://i.ibb.co.com/GfswcC5V/FB-IMG-1791925489216.jpg" alt="Google Marketing Logo">
            <span>Google Marketing</span>
        </div>
        <button class="menu-btn" onclick="toggleMenu()">MENU</button>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" onclick="toggleMenu()">CLOSE</button>
        <ul>
            <li><a href="#home" onclick="toggleMenu()">Home</a></li>
            <li><a href="#services" onclick="toggleMenu()">Services</a></li>
            <li><a href="#reviews" onclick="toggleMenu()">Reviews</a></li>
            <li><a href="#about" onclick="toggleMenu()">About Me</a></li>
            <li><a href="#contact" onclick="toggleMenu()">Contact</a></li>
        </ul>
        <div class="mobile-contact">
            <p>Get in touch</p>
            <a href="mailto:24.7.g00glemarketing@.com" style="display:block; margin-bottom:10px;">24.7.g00glemarketing@.com</a>
            <a href="tel:+8801647323233" style="display:block; margin-bottom:10px;">+880 1647-323233</a>
            <span style="color:var(--primary-color); font-size:0.9rem;">WhatsApp Available</span>
        </div>
    </div>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <h1>Hi, I'm Shakil<br><span>Authentic Online Review Provider & Google Map SEO Specialist</span></h1>
        <p>Owner of Google Marketing, helping businesses grow with safe reviews, Google Map SEO, and digital marketing services.</p>
        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
            <a href="https://t.me/DirectorShakil" target="_blank" class="btn btn-telegram">
                <i class="fab fa-telegram-plane"></i> Message Us on Telegram
            </a>
            <a href="#contact" class="btn btn-outline">
                Get in Touch
            </a>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services">
        <div class="section-header">
            <span class="badge">Our Services</span>
            <h2>Our Professional Services</h2>
            <p>Comprehensive digital solutions to help your business grow and succeed online</p>
        </div>
        
        <div class="services-grid">
            <!-- Service 1 -->
            <div class="service-card">
                <div class="service-icon">📱</div>
                <h3>Play Store Review Service</h3>
                <p>Authentic and safe reviews for your mobile applications to boost visibility and credibility.</p>
                <ul>
                    <li><i class="fas fa-check"></i> 100% Safe and Authentic Reviews</li>
                    <li><i class="fas fa-check"></i> Gradual Review Delivery</li>
                    <li><i class="fas fa-check"></i> Positive Rating Improvement</li>
                    <li><i class="fas fa-check"></i> Increased App Downloads</li>
                    <li><i class="fas fa-check"></i> 24/7 Customer Support</li>
                </ul>
            </div>

            <!-- Service 2 -->
            <div class="service-card">
                <div class="service-icon">🗺️</div>
                <h3>Google Map Review Service</h3>
                <p>Professional Google My Business reviews to enhance your local business presence.</p>
                <ul>
                    <li><i class="fas fa-check"></i> Real User Reviews</li>
                    <li><i class="fas fa-check"></i> Local Business Visibility</li>
                    <li><i class="fas fa-check"></i> Improved Search Rankings</li>
                    <li><i class="fas fa-check"></i> Customer Trust Building</li>
                    <li><i class="fas fa-check"></i> Detailed Review Reports</li>
                </ul>
            </div>

            <!-- Service 3 -->
            <div class="service-card">
                <div class="service-icon">🎯</div>
                <h3>Google Map SEO Optimization</h3>
                <p>Complete optimization of your Google My Business profile for maximum local visibility.</p>
                <ul>
                    <li><i class="fas fa-check"></i> Profile Optimization</li>
                    <li><i class="fas fa-check"></i> Keyword Research</li>
                    <li><i class="fas fa-check"></i> Local SEO Strategy</li>
                    <li><i class="fas fa-check"></i> Business Information Updates</li>
                    <li><i class="fas fa-check"></i> Performance Monitoring</li>
                </ul>
            </div>

            <!-- Service 4 -->
            <div class="service-card">
                <div class="service-icon">📈</div>
                <h3>Digital Marketing Services</h3>
                <p>Lead generation, Facebook ads, and email marketing to grow your business online.</p>
                <ul>
                    <li><i class="fas fa-check"></i> Lead Generation Campaigns</li>
                    <li><i class="fas fa-check"></i> Facebook & Instagram Ads</li>
                    <li><i class="fas fa-check"></i> Email Marketing Automation</li>
                    <li><i class="fas fa-check"></i> Social Media Management</li>
                    <li><i class="fas fa-check"></i> ROI Tracking & Analytics</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Work Process Section -->
    <section style="background-color: var(--surface-color);">
        <div class="section-header">
            <h2>Our Work Process</h2>
        </div>
        <div class="process-grid">
            <div class="process-step">
                <div class="step-number">01</div>
                <div class="step-icon">📋</div>
                <h3>Order Placement</h3>
                <p>Client submits an order for reviews or SEO services through our contact channels.</p>
            </div>
            <div class="process-step">
                <div class="step-number">02</div>
                <div class="step-icon">⚡</div>
                <h3>Service Execution</h3>
                <p>We provide authentic reviews or SEO services according to client requirements with full professionalism.</p>
            </div>
            <div class="process-step">
                <div class="step-number">03</div>
                <div class="step-icon">📊</div>
                <h3>Report Submission</h3>
                <p>Client receives detailed review/SEO report with complete documentation of work completed.</p>
            </div>
            <div class="process-step">
                <div class="step-number">04</div>
                <div class="step-icon">💳</div>
                <h3>Payment</h3>
                <p>Client completes payment after report confirmation. Payments are processed daily for transparency.</p>
            </div>
        </div>
    </section>
    
    <!-- Why Choose Us -->
    <section>
        <div class="section-header">
            <h2>Why Choose Us</h2>
        </div>
        <div class="services-grid">
            <div class="service-card" style="text-align: center;">
                <div class="service-icon">🛡️</div>
                <h3>Trusted Service</h3>
                <p>Years of experience serving clients worldwide with consistent quality.</p>
            </div>
            <div class="service-card" style="text-align: center;">
                <div class="service-icon">🔒</div>
                <h3>Safe Work</h3>
                <p>100% safe methods that comply with platform guidelines and policies.</p>
            </div>
            <div class="service-card" style="text-align: center;">
                <div class="service-icon">💰</div>
                <h3>Refund Policy</h3>
                <p>Money-back guarantee if we fail to deliver as promised.</p>
            </div>
            <div class="service-card" style="text-align: center;">
                <div class="service-icon">⭐</div>
                <h3>Client Satisfaction</h3>
                <p>99% client satisfaction rate with ongoing support and communication.</p>
            </div>
        </div>
    </section>

    <!-- Reviews Section -->
    <section id="reviews" style="background-color: var(--surface-color);">
        <div class="reviews-header">
            <span class="badge">Client Reviews</span>
            <h2>Our Delivered Reviews</h2>
            <p>These are authentic reviews we have provided for our clients. We deliver high-quality reviews in all languages to boost your app's credibility and ratings.</p>
        </div>

        <div class="gallery-grid">
            <!-- Review Images -->
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/bjNnYhn9/photo-2026-08-29-15-40-04.jpg')">
                <img src="https://i.ibb.co/bjNnYhn9/photo-2026-08-29-15-40-04.jpg" alt="Client Review">
            </div>
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/N2vkBysr/1000036467.jpg')">
                <img src="https://i.ibb.co/N2vkBysr/1000036467.jpg" alt="Client Review">
            </div>
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/N6Sgk64b/1000036468.jpg')">
                <img src="https://i.ibb.co/N6Sgk64b/1000036468.jpg" alt="Client Review">
            </div>
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/8n64yyBn/1000036469.jpg')">
                <img src="https://i.ibb.co/8n64yyBn/1000036469.jpg" alt="Client Review">
            </div>
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/ds9nyPrW/1000220007.jpg')">
                <img src="https://i.ibb.co/ds9nyPrW/1000220007.jpg" alt="Client Review">
            </div>
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/RTCBKs9v/12482.jpg')">
                <img src="https://i.ibb.co/RTCBKs9v/12482.jpg" alt="Client Review">
            </div>
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/5xg7V6bw/1000220465.jpg')">
                <img src="https://i.ibb.co/5xg7V6bw/1000220465.jpg" alt="Client Review">
            </div>
            <div class="gallery-item" onclick="openModal('https://i.ibb.co/39xR5FWS/1000036653.jpg')">
