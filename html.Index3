<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Marketing - Authentic Online Review Provider & Google Map SEO Specialist</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Premium Dark Theme Variables */
        :root {
            --bg-color: #030712; /* Deep dark background */
            --surface-color: #0f172a; /* Slightly lighter surface */
            --card-bg: rgba(30, 41, 59, 0.5); /* Glassmorphism card */
            --primary-color: #3b82f6; /* Premium Blue */
            --primary-glow: rgba(59, 130, 246, 0.5);
            --accent-color: #f59e0b; /* Amber/Gold accent */
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        h1, h2, h3, h4, h5, h6, .menu-btn, .logo span {
            font-family: 'Outfit', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: var(--text-main);
            transition: all 0.3s ease;
        }

        a:hover {
            color: var(--primary-color);
        }

        /* Ambient Background Glows */
        .ambient-glow {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: -1;
            background: 
                radial-gradient(circle at 15% 30%, rgba(59, 130, 246, 0.12), transparent 40%),
                radial-gradient(circle at 85% 70%, rgba(245, 158, 11, 0.08), transparent 40%);
        }

        /* Navbar */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 15px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: rgba(3, 7, 18, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 1000;
            border-bottom: 1px solid var(--border-color);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo img {
            width: 45px;
            height: 45px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid var(--border-color);
        }

        .logo span {
            font-weight: 700;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
            background: linear-gradient(to right, #fff, #94a3b8);
            -webkit-background-clip: text;
            color: transparent;
        }

        .menu-btn {
            background: none;
            border: none;
            color: var(--text-main);
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Mobile Menu */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: rgba(3, 7, 18, 0.98);
            backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            transform: translateY(-100%);
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .mobile-menu.active {
            transform: translateY(0);
        }

        .close-menu {
            position: absolute;
            top: 30px;
            right: 5%;
            background: none;
            border: none;
            color: var(--text-main);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 1px;
            font-family: 'Outfit', sans-serif;
        }

        .mobile-menu ul {
            list-style: none;
            text-align: center;
        }

        .mobile-menu ul li {
            margin: 25px 0;
        }

        .mobile-menu ul li a {
            font-size: 2.5rem;
            font-weight: 600;
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(to right, #fff, #fff);
            -webkit-background-clip: text;
            color: transparent;
            transition: 0.3s;
        }

        .mobile-menu ul li a:hover {
            background: linear-gradient(to right, #3b82f6, #60a5fa);
            -webkit-background-clip: text;
        }

        /* Hero Section */
        .hero {
            padding: 160px 5% 100px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero h1 span {
            background: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);
            -webkit-background-clip: text;
            color: transparent;
        }

        .hero p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 650px;
            margin-bottom: 40px;
            font-weight: 400;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 32px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            cursor: pointer;
            border: none;
            font-family: 'Outfit', sans-serif;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: white;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
        }

        .btn-primary:hover {
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
            transform: translateY(-2px);
        }
        
        .btn-outline {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-main);
        }
        
        .btn-outline:hover {
            background-color: rgba(255, 255, 255, 0.05);
            border-color: var(--text-muted);
        }

        /* Trust Counter Section */
        .trust-counter {
            padding: 0 5% 80px;
            margin-top: -60px;
            position: relative;
            z-index: 10;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 30px 20px;
            text-align: center;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: all 0.4s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            border-color: var(--primary-color);
            box-shadow: 0 15px 30px rgba(59, 130, 246, 0.15);
        }

        .stat-icon {
            font-size: 2.2rem;
            color: var(--primary-color);
            margin-bottom: 15px;
            filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.4));
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            font-family: 'Outfit', sans-serif;
            margin-bottom: 5px;
            line-height: 1.2;
        }

        .stat-text {
            color: var(--text-muted);
            font-size: 1rem;
            font-weight: 500;
        }

        /* Sections General */
        section {
            padding: 100px 5%;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .badge {
            display: inline-block;
            padding: 6px 16px;
            background-color: rgba(59, 130, 246, 0.1);
            color: var(--primary-color);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .section-header h2 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .section-header p {
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Services Grid */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .service-card {
            background-color: var(--card-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 40px 30px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .service-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary-color);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        /* Popular Ribbon */
        .ribbon {
            position: absolute;
            top: 25px;
            right: -40px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            padding: 8px 45px;
            transform: rotate(45deg);
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 1px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            text-transform: uppercase;
        }

        .service-icon {
            width: 65px;
            height: 65px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(59, 130, 246, 0.05));
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: var(--primary-color);
            margin-bottom: 25px;
        }

        .service-card h3 {
            font-size: 1.5rem;
            margin-bottom: 15px;
        }
        
        .service-card p {
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .service-card ul {
            list-style: none;
            color: var(--text-muted);
            margin-top: auto;
            margin-bottom: 25px;
        }
        
        .service-card ul li {
            margin-bottom: 12px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 0.95rem;
        }
        
        .service-card ul li i {
            color: var(--primary-color);
            margin-top: 5px;
            font-size: 0.8rem;
        }

        .price-tag {
            display: inline-block;
            margin-top: auto;
            padding: 10px 18px;
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 12px;
            color: var(--text-main);
            font-weight: 600;
            font-size: 1.05rem;
            text-align: center;
        }

        .price-tag span {
            color: var(--primary-color);
            font-size: 1.2rem;
            font-weight: 700;
        }

        /* Payment Terms & Guarantee */
        .guarantee-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: stretch;
            max-width: 1200px;
            margin: 0 auto;
        }

        .payment-panel, .guarantee-panel {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 40px;
            backdrop-filter: blur(12px);
        }

        .guarantee-panel {
            border-color: var(--primary-color);
            box-shadow: 0 0 40px rgba(59, 130, 246, 0.15);
            position: relative;
        }
        
        .guarantee-panel::before {
            content: '';
            position: absolute;
            inset: -1px;
            background: linear-gradient(135deg, var(--primary-color), transparent 60%);
            border-radius: 24px;
            z-index: -1;
            opacity: 0.5;
        }

        .panel-title {
            font-size: 1.8rem;
            margin-bottom: 30px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .panel-title i {
            color: var(--primary-color);
        }

        .payment-methods {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .payment-item {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(0,0,0,0.3);
            padding: 16px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .payment-item:hover {
            border-color: var(--text-muted);
            background: rgba(255,255,255,0.05);
            transform: translateY(-2px);
        }

        .payment-item i {
            font-size: 1.4rem;
            color: var(--primary-color);
        }

        .guarantee-list {
            list-style: none;
        }

        .guarantee-list li {
            margin-bottom: 22px;
            display: flex;
            align-items: flex-start;
            gap: 16px;
            font-size: 1.05rem;
            color: var(--text-main);
            line-height: 1.5;
        }

        .guarantee-list li i {
            color: #10b981; /* Success Green */
            font-size: 1.3rem;
            margin-top: 2px;
            background: rgba(16, 185, 129, 0.1);
            padding: 5px;
            border-radius: 50%;
        }

        /* Reviews Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .gallery-item {
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            aspect-ratio: 9 / 16; /* Mobile screenshot ratio */
            cursor: pointer;
            border: 1px solid var(--border-color);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.05);
        }

        /* FAQ Section */
        .faq-container {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .faq-item {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .faq-question {
            padding: 22px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            font-size: 1.1rem;
            color: var(--text-main);
            transition: all 0.3s ease;
        }

        .faq-question:hover {
            color: var(--primary-color);
        }

        .faq-question i {
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            color: var(--primary-color);
            font-size: 1.2rem;
        }

        .faq-answer {
            padding: 0 30px;
            max-height: 0;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            color: var(--text-muted);
            opacity: 0;
        }

        .faq-item.active {
            border-color: var(--primary-color);
            box-shadow: 0 5px 20px rgba(59, 130, 246, 0.15);
        }

        .faq-item.active .faq-question {
            color: var(--primary-color);
        }

        .faq-item.active .faq-question i {
            transform: rotate(180deg);
        }

        .faq-item.active .faq-answer {
            padding: 0 30px 22px;
            max-height: 300px;
            opacity: 1;
        }

        /* Advanced Contact Form */
        .contact-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 40px;
            backdrop-filter: blur(10px);
        }

        .contact-info-panel h3 {
            font-size: 2rem;
            margin-bottom: 20px;
        }

        .contact-info-panel p {
            color: var(--text-muted);
            margin-bottom: 30px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-item .icon {
            width: 45px;
            height: 45px;
            background-color: rgba(255,255,255,0.03);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-color);
            font-size: 1.2rem;
        }

        .info-item div p:first-child {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 0;
        }
        .info-item div p:last-child {
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 0;
        }

        .custom-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .input-group label {
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .input-group input, .input-group textarea {
            width: 100%;
            padding: 15px;
            background-color: rgba(0,0,0,0.2);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: white;
            font-size: 1rem;
            transition: 0.3s;
        }

        .input-group input:focus, .input-group textarea:focus {
            outline: none;
            border-color: var(--primary-color);
            background-color: rgba(59, 130, 246, 0.05);
        }

        .send-options {
            display: none;
            flex-direction: column;
            gap: 15px;
            margin-top: 10px;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .btn-wa { background-color: #25D366; color: white; border: none; }
        .btn-tg { background-color: #0088cc; color: white; border: none; }
        .btn-mail { background-color: #ea4335; color: white; border: none; }

        .btn-wa:hover { background-color: #1ebe57; transform: translateY(-2px); }
        .btn-tg:hover { background-color: #0077b5; transform: translateY(-2px); }
        .btn-mail:hover { background-color: #d33828; transform: translateY(-2px); }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 3000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.95);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            max-width: 90%;
            max-height: 90vh;
            border-radius: 12px;
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            color: white;
            font-size: 40px;
            font-weight: 300;
            cursor: pointer;
        }

        /* Footer Trust Badges */
        .footer-trust-badges {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        .footer-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 500;
        }

        .footer-badge i {
            color: var(--primary-color);
            font-size: 1.2rem;
        }

        /* Responsive */
        @media (max-width: 991px) {
            .contact-wrapper, .guarantee-wrapper {
                grid-template-columns: 1fr;
            }
            .payment-methods {
                grid-template-columns: 1fr;
            }
        }
        @media (max-width: 768px) {
            .hero {
                padding-top: 130px;
                text-align: center;
                align-items: center;
            }
            .trust-counter {
                padding: 0 5% 50px;
                margin-top: 0;
            }
        }
    </style>
</head>
<body>

    <div class="ambient-glow"></div>

    <!-- Navbar -->
    <nav>
        <div class="logo">
            <img src="https://i.ibb.co.com/GfswcC5V/FB-IMG-1791925489216.jpg" alt="Google Marketing Logo">
            <span>Google Marketing</span>
        </div>
        <button class="menu-btn" onclick="toggleMenu()">
            MENU <i class="fas fa-bars"></i>
        </button>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" onclick="toggleMenu()"><i class="fas fa-times"></i> CLOSE</button>
        <ul>
            <li><a href="#home" onclick="toggleMenu()">Home</a></li>
            <li><a href="#services" onclick="toggleMenu()">Services</a></li>
            <li><a href="#guarantee" onclick="toggleMenu()">Guarantee</a></li>
            <li><a href="#reviews" onclick="toggleMenu()">Reviews</a></li>
            <li><a href="#about" onclick="toggleMenu()">About Me</a></li>
            <li><a href="#faq" onclick="toggleMenu()">FAQ</a></li>
            <li><a href="#contact" onclick="toggleMenu()">Contact</a></li>
        </ul>
    </div>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <span class="badge">Professional Agency</span>
        <h1>Hi, I'm Shakil<br><span>Authentic Review & SEO Specialist</span></h1>
        <p>Owner of Google Marketing. We help businesses scale rapidly with safe, authentic reviews, powerful Google Map SEO, and targeted digital marketing solutions.</p>
        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
            <a href="#contact" class="btn btn-primary">
                Start Your Project
            </a>
            <a href="#services" class="btn btn-outline">
                Explore Services
            </a>
        </div>
    </section>

    <!-- Trust Counter Section -->
    <div class="trust-counter">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-check-double"></i></div>
                <div class="stat-number">500+</div>
                <div class="stat-text">Projects Completed</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-globe"></i></div>
                <div class="stat-number">300+</div>
                <div class="stat-text">Global Clients</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-award"></i></div>
                <div class="stat-number">3+</div>
                <div class="stat-text">Years Experience</div>
            </div>
            <div class="stat-card">
