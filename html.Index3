    <!-- JavaScript for Interactivity -->
    <script>
        // Toggle Mobile Menu
        function toggleMenu() {
            document.getElementById('mobileMenu').classList.toggle('active');
        }

        // Image Modal Logic
        const modal = document.getElementById("imageModal");
        const modalImg = document.getElementById("modalImg");

        function openModal(src) {
            modal.style.display = "flex";
            modalImg.src = src;
        }

        function closeModal() {
            modal.style.display = "none";
        }

        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") closeModal();
        });

        // FAQ Accordion Logic
        const faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(item => {
            const question = item.querySelector('.faq-question');
            question.addEventListener('click', () => {
                const isActive = item.classList.contains('active');
                
                // Close all other FAQs
                faqItems.forEach(otherItem => {
                    otherItem.classList.remove('active');
                });

                // Toggle current FAQ
                if (!isActive) {
                    item.classList.add('active');
                }
            });
        });

        // Form Logic
        function showOptions() {
            const appName = document.getElementById('appName').value.trim();
            const contact = document.getElementById('userContact').value.trim();

            if (!appName || !contact) {
                alert("Please fill in the App Name/ID and your Contact Info before proceeding.");
                return;
            }
            
            // Hide main button, show 3 platform buttons
            document.getElementById('mainSubmitBtn').style.display = 'none';
            document.getElementById('sendOptionsBlock').style.display = 'flex';
        }

        function sendMessage(platform) {
            const appName = document.getElementById('appName').value.trim();
            const contact = document.getElementById('userContact').value.trim();
            const message = document.getElementById('userMessage').value.trim() || 'No additional message.';

            // Format the message
            const textRaw = `🚀 *New Service Request* 🚀\n\n📱 *App/Target:* ${appName}\n📞 *Client Info:* ${contact}\n💬 *Message:* ${message}`;
            const encodedText = encodeURIComponent(textRaw);

            if (platform === 'whatsapp') {
                window.open(`https://wa.me/8801647323233?text=${encodedText}`, '_blank');
            } else if (platform === 'telegram') {
                window.open(`https://t.me/DirectorShakil?text=${encodedText}`, '_blank');
            } else if (platform === 'email') {
                const subject = encodeURIComponent("New Service Request - Google Marketing");
                window.open(`mailto:24.7.g00glemarketing@.com?subject=${subject}&body=${encodedText}`, '_blank');
            }
        }
    </script>
</body>
</html>
